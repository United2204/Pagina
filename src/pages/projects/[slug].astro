---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../components/BaseLayout.astro';
import Badge from '../../components/Badge.astro';
import Button from '../../components/Button.astro';
import FreeProjectNotice from '../../components/FreeProjectNotice.astro';
import SocialButton from '../../components/SocialButton.astro';
import { getProject, projects } from '../../data/projects';
import { withBase } from '../../config/site';

export const getStaticPaths = (() =>
  projects.map((project) => ({ params: { slug: project.slug } }))) satisfies GetStaticPaths;
const project = getProject(Astro.params.slug ?? '');
if (!project) throw new Error('Proyecto no encontrado');
const statusTone =
  project.status === 'Activo'
    ? 'active'
    : project.status === 'Próximamente'
      ? 'upcoming'
      : 'experimental';
const projectData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: project.name,
  description: project.description,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: project.platforms.join(', '),
};
---

<BaseLayout title={project.name} description={project.summary} structuredData={projectData}>
  <header class="page-header">
    <div class="container project-hero">
      <div>
        <p class="breadcrumbs">
          <a href={withBase('/projects/')}>Proyectos</a> / {project.name}
        </p><Badge tone={statusTone}>{project.status}</Badge><h1>{project.name}</h1><p>
          {project.description}
        </p><div class="actions-row">
          <Button href={withBase('/projects/')} variant="secondary">Todos los proyectos</Button>{
            project.repository && (
              <Button href={project.repository} variant="secondary" external>
                Repositorio
              </Button>
            )
          }{
            project.downloadUrl && (
              <Button href={project.downloadUrl} external>
                Descargar
              </Button>
            )
          }{
            project.issuesUrl && (
              <Button href={project.issuesUrl} variant="quiet" external>
                Reportar un error
              </Button>
            )
          }{
            project.communityUrl && (
              <SocialButton
                href={project.communityUrl}
                label="Reportar en Discord"
                icon="D"
                service="discord"
                external
              />
            )
          }
        </div>
      </div><div class="project-hero__visual">
        {
          project.image ? (
            <img
              src={withBase(project.image)}
              alt={project.imageAlt ?? `Captura de ${project.name}`}
            />
          ) : (
            <span aria-hidden="true">{project.placeholder}</span>
          )
        }
      </div>
    </div>
  </header>
  <section class="section">
    <div class="container content-grid">
      <div class="prose">
        <h2>Qué es</h2><p>{project.description}</p><h2>Características</h2><ul>
          {project.features.map((feature) => <li>{feature}</li>)}
        </ul><h2>Capturas y documentación</h2><p>
          Las capturas y documentación de este proyecto se publicarán aquí cuando estén disponibles.
          Puedes reemplazar este texto por imágenes optimizadas dentro de <code>src/assets</code> o enlaces
          a una guía externa.
        </p><h2>Cómo contribuir</h2><p>{project.contribution}</p><FreeProjectNotice />
      </div><aside>
        <section class="sidebar-card">
          <h2>Detalles</h2><dl class="definition-list">
            <div><dt>Estado</dt><dd>{project.status}</dd></div>{
              project.version && (
                <div>
                  <>
                    <dt>Versión</dt>
                    <dd>{project.version}</dd>
                  </>
                </div>
              )
            }<div>
              <dt>Plataformas</dt><dd>{project.platforms.join(', ')}</dd>
            </div><div><dt>Tecnologías</dt><dd>{project.technologies.join(', ')}</dd></div>
          </dl>
        </section><section class="sidebar-card">
          <h2>Changelog</h2><ul class="changelog">
            {
              project.changelog.map((change) => (
                <li>
                  <>
                    <strong>{change.version}</strong>
                    <br />
                    <small>{change.date}</small>
                    <p>{change.notes}</p>
                  </>
                </li>
              ))
            }
          </ul>
        </section>
      </aside>
    </div>
  </section>
</BaseLayout>
