---
import BaseLayout from '../components/BaseLayout.astro';
import Button from '../components/Button.astro';
import FreeProjectNotice from '../components/FreeProjectNotice.astro';
import SocialButton from '../components/SocialButton.astro';
import { siteConfig } from '../config/site';
---

<BaseLayout
  title="Apoyar"
  description="Formas opcionales de apoyar el desarrollo gratuito de United Software."
>
  <header class="page-header">
    <div class="container">
      <p class="eyebrow">APOYO OPCIONAL</p>
      <h1>Los proyectos son y seguirán siendo gratuitos.</h1>
      <p>
        Todo se crea y mantiene en tiempo libre. Si te resulta útil, puedes colaborar de manera
        opcional con costos de publicación, dominio, mantenimiento y desarrollo.
      </p>
    </div>
  </header>
  <section class="section">
    <div class="container">
      <FreeProjectNotice />
      <div class="support-grid" style="margin-top: 1.2rem">
        <article class="support-card">
          <h2>Ko-fi</h2>
          <p>Una colaboración puntual para cubrir costos y tiempo de desarrollo.</p>
          <Button href={siteConfig.social.kofi} variant="secondary" external>Apoyar en Ko-fi</Button
          >
        </article>
        <article class="support-card">
          <h2>Una estrella en GitHub</h2>
          <p>Dar una estrella ayuda a que otras personas encuentren los proyectos.</p>
          <Button href={siteConfig.social.github} variant="secondary" external
            >Visitar GitHub</Button
          >
        </article>
        <article class="support-card">
          <h2>Reportar errores</h2>
          <p>Un reporte claro es una de las formas más útiles de colaborar.</p>
          <SocialButton
            href={`mailto:${siteConfig.author.email}?subject=Reporte%20de%20error%20-%20United%20Software`}
            label="Reportar por correo"
            icon="@"
            service="email"
          />
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
