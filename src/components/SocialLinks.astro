---
import { siteConfig } from '../config/site';
import SocialButton from './SocialButton.astro';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<nav
  class:list={['social-links', { 'social-links--compact': compact }]}
  aria-label="Enlaces sociales"
>
  <a href={siteConfig.social.github} target="_blank" rel="noreferrer">GitHub ↗</a>
  <SocialButton href={siteConfig.social.x} label="X" icon="𝕏" service="x" external />
  {
    !compact && (
      <SocialButton
        href={`mailto:${siteConfig.author.email}`}
        label="Correo"
        icon="@"
        service="email"
      />
    )
  }
</nav>
