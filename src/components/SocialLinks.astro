---
import { siteConfig } from '../config/site';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<nav
  class:list={['social-links', { 'social-links--compact': compact }]}
  aria-label="Enlaces sociales"
>
  <a href={siteConfig.social.github} target="_blank" rel="noreferrer"
    >GitHub <span aria-hidden="true">↗</span></a
  >
  <a href={siteConfig.social.x} target="_blank" rel="noreferrer"
    >X <span aria-hidden="true">↗</span></a
  >
  {!compact && <a href={`mailto:${siteConfig.author.email}`}>Contacto</a>}
</nav>
